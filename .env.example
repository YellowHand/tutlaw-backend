# Gradus iuris, backend: szablon zmiennych środowiskowych. Skopiuj do .env i uzupełnij. Prawdziwego .env NIE wrzucaj do gita
# (jest w .gitignore). Ten plik zawiera tylko przykładowe wartości.
#
# Dwa środowiska, ten sam kod:
#  - LOKALNIE: profil dev (patrz niżej). Wszystko poniżej ma wtedy sensowne wartości domyślne (patrz application-dev.yml),
#    a docker compose czyta z tego pliku tylko dane bazy (POSTGRES_*).
#  - PRODUKCJA: bez profilu. Wszystkie zmienne oznaczone (WYMAGANE) muszą być ustawione na serwerze (plik deploy/.env.prod),
#    inaczej aplikacja nie wystartuje. Szablon produkcyjny: deploy/.env.prod.example.

# Profil dev włącz POZA tym plikiem (to pewny sposób): w IntelliJ pole „Active profiles” = dev albo z terminala
# ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev. Na serwerze profilu NIE ustawiaj.

# --- Baza (docker compose lokalnie; na produkcji tu wpisujesz dane z RDS) ---
POSTGRES_DB=gradusiuris
POSTGRES_USER=gradusiuris_user
POSTGRES_PASSWORD=gradusiuris_password

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gradusiuris
SPRING_DATASOURCE_USERNAME=gradusiuris_user
SPRING_DATASOURCE_PASSWORD=gradusiuris_password

# --- Sekret JWT (WYMAGANE na produkcji): min. 32 znaki, losowy. Wygeneruj: openssl rand -base64 48 ---
APP_JWT_SECRET=lokalny-dev-sekret-min-32-znaki-tylko-do-nauki-lokalnej

# --- Adres strony (WYMAGANE na produkcji, z https://). Lokalnie http://localhost:5173 ---
FRONTEND_URL=http://localhost:5173
# Opcjonalnie: kilka adresów dozwolonych w CORS po przecinku (np. z www). Domyślnie to samo co FRONTEND_URL.
# CORS_ALLOWED_ORIGINS=https://gradusiuris.pl,https://www.gradusiuris.pl

# --- Poczta ---
# Lokalnie: Mailpit z docker compose (localhost:1025, podgląd http://localhost:8025), bez logowania.
# Produkcja: Amazon SES przez SMTP, np. MAIL_HOST=email-smtp.eu-central-1.amazonaws.com, MAIL_PORT=587, dane SMTP z konsoli SES.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
# Nadawca (WYMAGANE na produkcji): adres w domenie zweryfikowanej w SES.
MAIL_FROM=Gradus iuris <no-reply@gradusiuris.local>
