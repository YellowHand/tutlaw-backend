# Caddy: przyjmuje HTTPS na api.gradusiuris.pl, sam pobiera i odnawia certyfikat (Let's Encrypt) i przekazuje ruch do backendu.
# Warunki: rekord DNS A api.gradusiuris.pl wskazuje na Elastic IP serwera, a grupa zabezpieczeń serwera przepuszcza porty 80 i 443.
#
# Cloudflare: rekord może być „Proxied” (pomarańczowa chmurka). Wtedy do serwera przychodzi ruch z adresów Cloudflare, a prawdziwy adres
# użytkownika jest w nagłówku CF-Connecting-IP. Ufamy temu nagłówkowi WYŁĄCZNIE, gdy żądanie przyszło z adresu Cloudflare (lista niżej);
# od kogokolwiek innego jest ignorowany, więc nie da się go podrobić, wchodząc na serwer bezpośrednio. Bez Cloudflare (szara chmurka)
# wszystko działa jak dotąd: adres użytkownika to adres, z którego przyszło połączenie.
#
# Lista adresów Cloudflare: https://www.cloudflare.com/ips/ (zmienia się rzadko; po zmianie zaktualizuj ją tutaj i wdróż ponownie).
{
	servers {
		trusted_proxies static 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 104.16.0.0/13 104.24.0.0/14 108.162.192.0/18 131.0.72.0/22 141.101.64.0/18 162.158.0.0/15 172.64.0.0/13 173.245.48.0/20 188.114.96.0/20 190.93.240.0/20 197.234.240.0/22 198.41.128.0/17 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

api.gradusiuris.pl {
	encode zstd gzip

	reverse_proxy backend:8080 {
		# Backend (Tomcat) bierze adres użytkownika z X-Forwarded-For. Podajemy mu jeden, pewny adres (ustalony wyżej), żeby limity prób
		# logowania działały per użytkownik, a nie per Cloudflare.
		header_up X-Forwarded-For {client_ip}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
