# Szablon sekretów produkcyjnych backendu. Na serwerze skopiuj jako /opt/gradusiuris/.env.prod i uzupełnij.
# Prawdziwy plik NIGDY nie trafia do gita. Uprawnienia: chmod 600 /opt/gradusiuris/.env.prod
#
# Produkcja działa BEZ profilu Springa (nie ustawiaj SPRING_PROFILES_ACTIVE). Brak którejkolwiek zmiennej WYMAGANEJ albo
# wartość z szablonu (np. sekret zaczynający się od „lokalny-dev”) kończy się odmową startu z komunikatem w logu.

# --- Baza: Amazon RDS (WYMAGANE) ---
# Adres (endpoint) z konsoli RDS. sslmode=require wymusza szyfrowane połączenie.
SPRING_DATASOURCE_URL=jdbc:postgresql://TU-WPISZ-ENDPOINT-RDS.eu-central-1.rds.amazonaws.com:5432/gradusiuris?sslmode=require
SPRING_DATASOURCE_USERNAME=gradusiuris_app
SPRING_DATASOURCE_PASSWORD=WPISZ-HASLO-BAZY

# --- Sekret JWT (WYMAGANE): min. 32 znaki, losowy, tylko tu. Wygeneruj: openssl rand -base64 48 ---
# Zmiana tego sekretu wylogowuje wszystkich użytkowników.
APP_JWT_SECRET=WPISZ-WYGENEROWANY-SEKRET

# --- Adres strony (WYMAGANE, https://) ---
FRONTEND_URL=https://gradusiuris.pl
# Opcjonalnie: dodatkowe dozwolone adresy w CORS (np. z www). Bez tego dozwolony jest tylko FRONTEND_URL.
# CORS_ALLOWED_ORIGINS=https://gradusiuris.pl,https://www.gradusiuris.pl

# --- Poczta: Amazon SES przez SMTP (WYMAGANE) ---
# Region musi być ten sam, w którym zweryfikowałeś domenę w SES (poniżej Frankfurt).
MAIL_HOST=email-smtp.eu-central-1.amazonaws.com
MAIL_PORT=587
# To są „SMTP credentials” z konsoli SES (nie klucze dostępu AWS i nie hasło konsoli).
MAIL_USERNAME=WPISZ-SMTP-USERNAME
MAIL_PASSWORD=WPISZ-SMTP-PASSWORD
# Nadawca: adres w domenie zweryfikowanej w SES.
MAIL_FROM=Gradus iuris <no-reply@gradusiuris.pl>
